			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Samuel\",\n    \"lastName\": \"Velasco\",\n    \"email\": \"sam@example.com\",\n    \"password\": \"SecurePassword123!\",\n    \"sin\": \"123456789\"\n}",
