{
    "info": {
        "name": "CanBankX API Tests",
        "description": "Tests des routes d'identité et de création de compte. NOTE: Utilisez la variable {{HOST}} pour basculer entre 'localhost' ou l'IP de la VM (ex: 10.194.32.243).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "0. Health Check",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://{{HOST}}:8080/health",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "health"
                    ]
                }
            }
        },
        {
            "name": "1. Register User",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"email\": \"alice@test.com\",\n  \"password\": \"Password123!\",\n  \"sin\": \"987654321\"\n}"
                },
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/identity/register",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "identity",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "2. Login (Get MFA Token)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "if (jsonData.mfaToken) { pm.collectionVariables.set(\"mfaToken\", jsonData.mfaToken); }"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"alice@test.com\",\n  \"password\": \"Password123!\"\n}"
                },
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/identity/login",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "identity",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "3. Verify MFA (Get Access Token)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "if (jsonData.token) { pm.collectionVariables.set(\"accessToken\", jsonData.token); } else if (jsonData.accessToken) { pm.collectionVariables.set(\"accessToken\", jsonData.accessToken); }"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"code\": \"123456\"\n}"
                },
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/identity/login/mfa",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "identity",
                        "login",
                        "mfa"
                    ]
                }
            }
        },
        {
            "name": "4. Test Protected Route (No Token) - Expect 401",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"type\": \"CHECKING\"\n}"
                },
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/accounts/",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "accounts",
                        ""
                    ]
                }
            }
        },
        {
            "name": "5. Test Protected Route (With Token) - Expect 201",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{accessToken}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"type\": \"CHECKING\"\n}"
                },
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/accounts/",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "accounts",
                        ""
                    ]
                }
            }
        },
        {
            "name": "6. Get Accounts (With Token) - Expect 200",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{accessToken}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/accounts/",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "accounts",
                        ""
                    ]
                }
            }
        },
        {
            "name": "7. Get Account History (With Token) - Expect 200",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{accessToken}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/accounts/1/history",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "accounts",
                        "1",
                        "history"
                    ]
                }
            }
        },
        {
            "name": "8. Internal Transfer",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{accessToken}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"idempotencyKey\": \"tx-req-001\",\n  \"sourceAccount\": 1,\n  \"targetAccount\": 2,\n  \"amount\": 50.0\n}"
                },
                "url": {
                    "raw": "http://{{HOST}}:8080/api/v1/transfers",
                    "protocol": "http",
                    "host": [
                        "{{HOST}}"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "transfers"
                    ]
                }
            }
        }
    ],
    "variable": [
        {
            "key": "HOST",
            "value": "localhost"
        },
        {
            "key": "mfaToken",
            "value": ""
        },
        {
            "key": "accessToken",
            "value": ""
        }
    ]
}
