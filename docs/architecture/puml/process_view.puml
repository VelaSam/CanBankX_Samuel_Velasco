@startuml ProcessViewDiagram
autonumber

actor Client
participant "API Router" as Router
participant "Middleware Auth" as Auth
participant "Transfers Handler" as Handler
participant "Transfers Bounded Context" as Transfers
participant "Accounts Bounded Context" as Accounts
participant "Ledger Bounded Context" as Ledger
database "MySQL" as DB

Client -> Router: POST /api/v1/accounts (Bearer Token)
Router -> Auth: Execution (gin handler)
Auth -> Auth: Validate JWT Token & Extract UserID
Auth --> Router: Add UserID to Context
Router -> Handler: Forward Request
 
Handler -> Accounts: OpenAccount(req)
activate Accounts

Accounts -> DB: BEGIN Transaction
activate DB
 
Accounts -> DB: INSERT INTO accounts
Accounts -> DB: COMMIT Transaction
deactivate DB

Accounts --> Handler: Success (Account Created)
deactivate Accounts
 
Handler --> Client: 201 Created
activate Accounts

@enduml
