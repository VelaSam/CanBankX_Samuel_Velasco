@startuml
left to right direction
skinparam packageStyle rectangle

actor "Client" as client
actor "Opérations" as ops
actor "Régulateur/Conformité" as reg

rectangle "CanBankX - Plateforme Bancaire" {
  usecase "UC-01\nInscription KYC" as UC1
  usecase "UC-02\nAuthentification & MFA" as UC2
  usecase "UC-03\nOuverture de Compte" as UC3
  usecase "UC-04\nConsultation Soldes\net Historiques" as UC4
  usecase "UC-05\nVirement (Interne/Interac)" as UC5
  usecase "UC-06\nPaiement de Factures" as UC6
  usecase "UC-07\nDétection d'Activités\nSuspectes (AML)" as UC7
  usecase "UC-08\nClôture Journalière\net Relevés (EOD)" as UC8
}

client --> UC1
client --> UC2
client --> UC3
client --> UC4
client --> UC5
client --> UC6

reg --> UC7
ops --> UC8

UC3 .> UC2 : include
UC4 .> UC2 : include
UC5 .> UC2 : include
UC6 .> UC2 : include
UC5 .> UC7 : extend (Vérification AML)

@enduml
